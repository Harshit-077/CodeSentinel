# ─── LLM ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── DATABASE ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/codereview

# ─── VECTOR DB ────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ─── EMBEDDINGS ───────────────────────────────────────
# Uses HuggingFace sentence-transformers (free, local)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── APP ──────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_this_to_a_random_secret_32chars
DEMO_USERNAME=admin
DEMO_PASSWORD=demo1234

# ─── FILE STORAGE ─────────────────────────────────────
UPLOAD_DIR=./uploads
REPORT_DIR=./reports

# ─── CORS ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
